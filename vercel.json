{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "functions": {
    "api/generate-story-illustration.js": {
      "includeFiles": "assets/{stories,slides-web}/*.{png,jpg,jpeg,webp}"
    }
  },
  "rewrites": [
    { "source": "/games/endless-flight", "destination": "/endless-flight.html" },
    { "source": "/games/memory", "destination": "/" },
    { "source": "/memory", "destination": "/" }
  ]
}
